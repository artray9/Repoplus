# === Repoplus Backend — Environment Variables ===

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/repoplus

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
ADMIN_SECRET=secret-to-create-first-admin

# Шифрование токенов at-rest (AES-256-GCM).
# Любая длинная случайная строка. БЕЗ неё токены хранятся в открытом виде.
# ВАЖНО: меняешь ключ → старые зашифрованные токены перестанут читаться.
TOKEN_ENC_KEY=replace-with-long-random-string

# Frontend URL (для CORS)
FRONTEND_URL=https://repoplus.kz

# Port
PORT=3001

# Facebook
FB_APP_ID=
FB_APP_SECRET=

# Google Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_MCC_ID=

# TikTok
TT_APP_ID=
TT_APP_SECRET=

# amoCRM
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://repoplus.kz/oauth/amocrm

# Telegram Alerts (для системных уведомлений)
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
